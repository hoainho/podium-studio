{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Podium Studio",
  "version": "0.1.0",
  "identifier": "com.podiumstudio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Podium Studio",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/podium-studio-bridge"],
    "resources": {
      "resources/podium-engine": "resources/podium-engine",
      "resources/bridge": "resources/bridge",
      "bundle-manifest.json": "bundle-manifest.json"
    }
  }
}
