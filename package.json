{
  "name": "podium-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Podium Studio — a non-tech-friendly desktop app for building and running deterministic e2e QA flows on the Podium engine.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n bridge,web -c cyan,magenta \"npm:dev:bridge\" \"npm:dev:web\"",
    "dev:bridge": "tsx watch bridge/server.ts",
    "dev:web": "vite",
    "bridge": "tsx bridge/server.ts",
    "build": "tsc -p tsconfig.node.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "sidecar:build": "node scripts/build-bridge-sidecar.mjs",
    "vendor:podium": "node scripts/vendor-podium-engine.mjs",
    "vendor:browser": "node scripts/vendor-browser-engine.mjs",
    "vendor:node-runtime": "node scripts/vendor-node-runtime.mjs",
    "manifest:generate": "node scripts/generate-bundle-manifest.mjs",
    "tauri": "tauri",
    "tauri:dev": "npm run sidecar:build && npm run vendor:podium && npm run vendor:node-runtime && npm run manifest:generate && tauri dev",
    "tauri:build": "npm run sidecar:build && npm run vendor:podium && npm run vendor:browser && npm run vendor:node-runtime && npm run manifest:generate && tauri build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "cloakbrowser": "^0.4.11",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
